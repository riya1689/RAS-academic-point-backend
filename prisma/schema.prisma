datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  emailVerified Boolean   @default(false)
  password  String
  role          Role      @default(STUDENT)
  image     String?
  createdAt DateTime @default(now())
  updatedAt     DateTime  @updatedAt

  student   Student?
  teacher   Teacher?
  guardian  Guardian?
  sessions      Session[]
  accounts      Account[]
}

model Student {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class      String
  roll       String
  department String
  schoolName String
  email      String?
  phone      String

  guardians  Guardian[]
  classrooms ClassroomMember[]
  attendance Attendance[]
  results    Result[]
  payments   TuitionPayment[]
  oneToOneBookings OneToOneBooking[]
  waitlistEntries  WaitlistEntry[]
}

// Session Model 
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Teacher {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId     String   @unique
  department    String
  qualification String

  classrooms    Classroom[]
  supportSessions SupportSession[]
  salaries      TeacherSalary[]
  availabilitySlots AvailabilitySlot[]
  googleAuth        TeacherGoogleAuth?
}

model Guardian {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Classroom {
  id            String   @id @default(uuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroomCode String   @unique
  title         String
  createdAt     DateTime @default(now())

  members       ClassroomMember[]
  attendance    Attendance[]
}

model ClassroomMember {
  id          String    @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date        DateTime
  status      AttendanceStatus

  @@unique([studentId, classroomId, date])
}

model Exam {
  id       String   @id @default(uuid())
  name     String
  examDate DateTime
  results  Result[]
}

enum ResultStatus {
  PASS
  FAIL
}

model Result {
  id                String       @id @default(uuid())
  studentId         String
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId            String
  exam              Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject           String
  writtenMark       Float
  mcqMark           Float
  practicalMark     Float?       // Nullable for practical marks
  totalMark         Float
  writtenPassMark   Float        @default(40)
  mcqPassMark       Float        @default(15)
  practicalPassMark Float?       @default(0)
  result            ResultStatus

  @@unique([studentId, examId, subject])
}

enum PaymentStatus {
  PAID
  UNPAID
  PENDING
}

enum PaymentMethod {
  ONLINE
  CASH
}

model TuitionPayment {
  id            String         @id @default(uuid())
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         String
  amount        Float
  status        PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?
  paymentDate   DateTime?
  createdAt     DateTime       @default(now())
}

model SupportSession {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime
  time      String
  meetLink  String?
}

model TeacherSalary {
  id          String        @id @default(uuid())
  teacherId   String
  teacher     Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month       String
  amount      Float
  status      PaymentStatus @default(PENDING)
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model AvailabilitySlot {
  id          String   @id @default(uuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  slotStart   DateTime
  slotEnd     DateTime
  isBooked    Boolean  @default(false)
  createdAt   DateTime @default(now())

  booking     OneToOneBooking?
  waitlist    WaitlistEntry[]

  @@index([slotStart])
  @@index([slotEnd])
}

model OneToOneBooking {
  id          String         @id @default(uuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slotId      String         @unique
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  meetLink    String?
  description String?
  status      BookingStatus  @default(CONFIRMED)
  createdAt   DateTime       @default(now())
}

model WaitlistEntry {
  id          String         @id @default(uuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slotId      String
  slot        AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  joinedAt    DateTime       @default(now())
}

model TeacherGoogleAuth {
  id           String   @id @default(uuid())
  teacherId    String   @unique
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  updatedAt    DateTime @updatedAt
}